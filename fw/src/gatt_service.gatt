// gatt_service.gatt
PRIMARY_SERVICE,
    0xFF10

    // --- Buttons (read + notify) ---
    // Button bitmask: bit0=SHOCK, bit1=ON_OFF, bit2=INFO
    CHARACTERISTIC,
    0xFF11, READ | NOTIFY,
    0

    // --- LEDs (read + write) ---
    // LED bitmask: bit0=SHOCK, bit1=ON_OFF, bit2=INFO, bit3=HANDS_OFF,
    //              bit4=LOW_BELLY, bit5=BREAST
    CHARACTERISTIC,
    0xFF12, READ | WRITE, 0

    // --- Classic audio status (read + notify) ---
    // bit0=classic peer address stored, bit1=classic link connected
    CHARACTERISTIC,
    0xFF13, READ | NOTIFY, 0

// OTA update service
PRIMARY_SERVICE,
    0xFF20

    // --- Control & status (read + write + notify) ---
    // write: [0x01][size:u32][crc32:u32] start, [0x02] finish, [0x03] abort
    // read/notify: [state:u8][progress:u32][error:u8]
    CHARACTERISTIC,
    0xFF21, READ | WRITE | NOTIFY, 0

    // --- Image data (write without response) ---
    CHARACTERISTIC,
    0xFF22, WRITE_WITHOUT_RESPONSE, 0